<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Text.Wallet.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="Text.Wallet.Heading" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Text.Wallet.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Text.Wallet.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.Wallet.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.Wallet.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/border</item>
    </style>
    <style name="Widget.Wallet.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="Widget.Wallet.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/border_width</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
