<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_md">
        <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/app_name" android:textAppearance="@style/Text.Wallet.Heading"/>
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/sign_in" android:textAppearance="@style/Text.Wallet.Title"/>
        <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/sign_in_description" android:textAppearance="@style/Text.Wallet.Caption"/>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/phoneLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:hint="@string/phone">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:inputType="phone" android:maxLength="128" android:saveEnabled="false" android:importantForAutofill="auto"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tokenLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:hint="@string/activation_token">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/token" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:inputType="textPassword" android:maxLength="128" android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:hint="@string/password">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:inputType="textPassword" android:maxLength="128" android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/confirmationLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:hint="@string/confirm_password">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/confirmation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:inputType="textPassword" android:maxLength="128" android:saveEnabled="false" android:importantForAutofill="noExcludeDescendants"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/useDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_target" android:text="@string/use_saved_device" android:checked="true"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/submit" style="@style/Widget.Wallet.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/sign_in"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/switchMode" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/activate_account"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
