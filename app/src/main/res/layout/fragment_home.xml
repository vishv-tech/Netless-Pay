<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_md">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/brand" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/app_name" android:textAppearance="@style/Text.Wallet.Heading"/>
                <TextView android:id="@+id/greeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/welcome" android:textAppearance="@style/Text.Wallet.Caption"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/lock" style="@style/Widget.Wallet.Outline" android:layout_width="@dimen/touch_target" android:layout_height="@dimen/touch_target" android:padding="0dp" app:icon="@drawable/ic_lock" app:iconPadding="0dp" app:iconGravity="textStart" android:contentDescription="@string/lock_or_setup"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:id="@+id/balanceCard" style="@style/Widget.Wallet.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_sm" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/cobalt" app:cardCornerRadius="@dimen/balance_radius" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_md">
                <TextView android:id="@+id/balanceLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/wallet_balance" android:textAppearance="@style/Text.Wallet.Body" android:textColor="@color/on_blue"/>
                <TextView android:id="@+id/balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/hidden_balance" android:textAppearance="@style/Text.Wallet.Title" android:minHeight="@dimen/touch_target" android:textSize="36sp" android:textColor="@color/on_blue"/>
                <TextView android:id="@+id/confirmationTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/not_confirmed" android:textAppearance="@style/Text.Wallet.Caption" android:textColor="@color/on_blue"/>
                <TextView android:id="@+id/balanceHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/tap_to_reveal" android:textAppearance="@style/Text.Wallet.Caption" android:textColor="@color/on_blue"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_md" android:baselineAligned="false">
            <com.google.android.material.button.MaterialButton android:id="@+id/scanQr" style="@style/Widget.Wallet.Outline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/scan_qr" android:enabled="false" android:layout_weight="1" app:icon="@drawable/ic_qr" app:iconGravity="textTop" android:maxLines="2"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/enterUpi" style="@style/Widget.Wallet.Outline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/enter_upi" android:enabled="false" android:layout_weight="1" android:layout_marginStart="@dimen/space_xs" app:icon="@drawable/ic_upi" app:iconGravity="textTop" android:maxLines="2"/>
        </LinearLayout>
        <TextView android:id="@+id/paymentStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/payments_unavailable" android:textAppearance="@style/Text.Wallet.Caption" android:layout_marginTop="@dimen/space_xs"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/history" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/transaction_history"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/refresh"/>
        <TextView android:id="@+id/prototype" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/prototype_notice" android:textAppearance="@style/Text.Wallet.Caption" android:layout_marginTop="@dimen/space_md"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
