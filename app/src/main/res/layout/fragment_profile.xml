<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_md">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/profile" android:textAppearance="@style/Text.Wallet.Title"/>
        <TextView android:id="@+id/identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/profile_loading" android:textAppearance="@style/Text.Wallet.Heading"/>
        <TextView android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/profile_loading" android:textAppearance="@style/Text.Wallet.Body"/>
        <TextView android:id="@+id/participant" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/profile_loading" android:textAppearance="@style/Text.Wallet.Caption"/>
        <TextView android:id="@+id/device" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/device_status" android:textAppearance="@style/Text.Wallet.Body"/>
        <TextView android:id="@+id/deviceDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/device_details" android:textAppearance="@style/Text.Wallet.Caption"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/replaceDevice" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/replace_device"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/revokeDevice" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/revoke_device"/>
        <TextView android:id="@+id/privacyTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/privacy" android:textAppearance="@style/Text.Wallet.Heading" android:layout_marginTop="@dimen/space_md"/>
        <TextView android:id="@+id/lockStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/app_lock_off" android:textAppearance="@style/Text.Wallet.Caption"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/manageLock" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/manage_app_lock"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/lockNow" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/lock_now"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/signOut" style="@style/Widget.Wallet.Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/sign_out"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/signOutAll" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/sign_out_all"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
