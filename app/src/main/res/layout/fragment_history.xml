<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/space_md">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/transaction_history" android:textAppearance="@style/Text.Wallet.Title"/>
        <TextView android:id="@+id/description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/history_description" android:textAppearance="@style/Text.Wallet.Caption"/>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/space_sm" android:text="@string/history_empty" android:textAppearance="@style/Text.Wallet.Body"/>
        <LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/loadMore" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/load_more"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/backHome" style="@style/Widget.Wallet.Outline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_xs" android:text="@string/back_home"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
